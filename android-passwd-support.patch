+#if ANDROID_PASSWD_FILE
+	/* -y given: parse our own passwd(5) file (Android /etc is read-only) */
+	if (android_passwd_file) {
+		pw = android_getpwnam(username);
+	} else
+#endif
+	{
+		pw = getpwnam(username);
+	}
