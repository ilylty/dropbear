diff --git a/src/android-passwd.c b/src/android-passwd.c
new file mode 100644
index 0000000..330a7ae
--- /dev/null
+++ b/src/android-passwd.c
@@ -0,0 +1,178 @@
+/* Android/read-only-rootfs support: read users from a custom passwd file
+ * instead of the libc getpwnam()/getspnam() (which hardcodes /etc/passwd and
+ * /etc/shadow, unavailable or read-only on Android).
+ *
+ * Enabled at runtime with  dropbear ... -y /data/local/tmp/dropbear/passwd
+ * The file uses the standard passwd(5) format:
+ *     name:password:uid:gid:gecos:home:shell
+ * The password field may contain the crypt hash directly ("$6$..." etc),
+ * "x" meaning "look up in the shadow file next to the passwd file",
+ * or "*"/"!" for a locked account.
+ */
+
+#include "includes.h"
+
+#if ANDROID_PASSWD_FILE
+
+#include <pwd.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+/* Set from svr-runopts (-y). NULL = use the normal libc lookup. */
+char *android_passwd_file = NULL;
+
+static struct passwd apw;
+static char *apw_name = NULL;
+static char *apw_passwd = NULL;
+static char *apw_dir = NULL;
+static char *apw_shell = NULL;
+static char *apw_gecos = NULL;
+
+static void apw_free(void) {
+    if (apw_name) { m_free(apw_name); apw_name = NULL; }
+    if (apw_passwd) { m_free(apw_passwd); apw_passwd = NULL; }
+    if (apw_dir) { m_free(apw_dir); apw_dir = NULL; }
+    if (apw_shell) { m_free(apw_shell); apw_shell = NULL; }
+    if (apw_gecos) { m_free(apw_gecos); apw_gecos = NULL; }
+}
+
+static char *apw_dup_field(const char *s) {
+    if (!s) {
+        return m_strdup("");
+    }
+    return m_strdup(s);
+}
+
+/* Look up "name" in the shadow file sitting beside the passwd file.
+ * Returns the crypt hash or NULL if the entry is absent. */
+static char *lookup_shadow(const char *username) {
+    char path[4096];
+    char line[4096];
+    FILE *fp = NULL;
+    char *slash = NULL;
+    size_t want;
+    char *result = NULL;
+
+    snprintf(path, sizeof(path), "%s", android_passwd_file);
+    slash = strrchr(path, '/');
+    if (slash) {
+        snprintf(slash + 1, sizeof(path) - (size_t)(slash + 1 - path), "shadow");
+    } else {
+        snprintf(path, sizeof(path), "shadow");
+    }
+
+    fp = fopen(path, "r");
+    if (!fp) {
+        return NULL;
+    }
+
+    want = strlen(username);
+    while (fgets(line, sizeof(line), fp) != NULL) {
+        char *saveptr = NULL;
+        char *field = NULL;
+        size_t len = strlen(line);
+        char *colon = NULL;
+
+        if (len == 0) {
+            continue;
+        }
+        if (line[len - 1] == '\n') {
+            line[len - 1] = '\0';
+        }
+
+        field = strtok_r(line, ":", &saveptr);
+        if (!field || strlen(field) != want || strncmp(field, username, want) != 0) {
+            continue;
+        }
+        /* second field is the hash */
+        field = strtok_r(NULL, ":", &saveptr);
+        if (!field) {
+            continue;
+        }
+        /* strip any trailing ":age:..." handled by strtok already */
+        colon = strchr(field, '\n');
+        if (colon) { *colon = '\0'; }
+        result = m_strdup(field);
+        break;
+    }
+    fclose(fp);
+    return result;
+}
+
+/* Parse the passwd file and fill in the static struct passwd.
+ * Returns NULL if the user is not found. */
+struct passwd *android_getpwnam(const char *username) {
+    char line[4096];
+    FILE *fp = NULL;
+    struct passwd *ret = NULL;
+    size_t want = strlen(username);
+
+    if (!android_passwd_file) {
+        return NULL;
+    }
+
+    fp = fopen(android_passwd_file, "r");
+    if (!fp) {
+        dropbear_log(LOG_WARNING, "Cannot open passwd file %s",
+                android_passwd_file);
+        return NULL;
+    }
+
+    while (fgets(line, sizeof(line), fp) != NULL) {
+        char *f[7];
+        char *saveptr = NULL;
+        char *tok = NULL;
+        int nf = 0;
+        size_t len = strlen(line);
+
+        if (len == 0 || line[0] == '#') {
+            continue;
+        }
+        if (line[len - 1] == '\n') {
+            line[len - 1] = '\0';
+        }
+
+        for (tok = strtok_r(line, ":", &saveptr); tok && nf < 7;
+                tok = strtok_r(NULL, ":", &saveptr)) {
+            f[nf++] = tok;
+        }
+        if (nf < 7) {
+            continue;
+        }
+        if (strlen(f[0]) != want || strncmp(f[0], username, want) != 0) {
+            continue;
+        }
+
+        apw_free();
+        apw_name = m_strdup(f[0]);
+        apw_dir = apw_dup_field(f[5]);
+        apw_shell = apw_dup_field(f[6]);
+        apw_gecos = apw_dup_field(f[4]);
+
+        if (strcmp(f[1], "x") == 0) {
+            char *sp = lookup_shadow(f[0]);
+            apw_passwd = sp ? sp : m_strdup("!!");
+            if (!sp) {
+                dropbear_log(LOG_DEBUG, "No shadow entry for %s", f[0]);
+            }
+        } else {
+            apw_passwd = apw_dup_field(f[1]);
+        }
+
+        apw.pw_name = apw_name;
+        apw.pw_passwd = apw_passwd;
+        apw.pw_uid = (uid_t)strtoul(f[2], NULL, 10);
+        apw.pw_gid = (gid_t)strtoul(f[3], NULL, 10);
+        apw.pw_gecos = apw_gecos;
+        apw.pw_dir = apw_dir;
+        apw.pw_shell = apw_shell;
+        ret = &apw;
+        break;
+    }
+
+    fclose(fp);
+    return ret;
+}
+
+#endif /* ANDROID_PASSWD_FILE */
